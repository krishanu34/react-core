# --- LLM provider selection ---
# gemini | openai | azure
# LLM_PROVIDER=gemini
LLM_PROVIDER=azure

# --- Embedding provider selection ---
# gemini | openai | azure
# EMBEDDING_PROVIDER=gemini
EMBEDDING_PROVIDER=azure

# --- Langfuse tracing ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# --- Google Gemini (default) ---
GEMINI_API_KEY=AQ.Ab8RN6L0COLRVA-jKgz0UP-4Cv9LsF1xmoqcH5ugd9LN-cyOPw
GEMINI_MODEL=gemini-3.7-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# --- OpenAI ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- Azure OpenAI ---
AZURE_OPENAI_API_KEY=3mKRF119AEpTTbX3Sni9MLimvTEXqxP4ie3Jb5UUhJycDEoSrAJwJQQJ99BDACYeBjFXJ3w3AAABACOGPqpm
AZURE_OPENAI_ENDPOINT=https://aoi-cme-nats-genai-eus.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT=gpt-5.6-terra
AZURE_OPENAI_MODEL=gpt-5.6-terra
AZURE_OPENAI_API_VERSION=2024-12-01-preview
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-large
AZURE_OPENAI_EMBEDDING_API_VERSION=2024-05-01-preview

# --- Server ---
REACT_CORE_HOST=127.0.0.1
REACT_CORE_PORT=8000
REACT_CORE_RELOAD=true

# Where per-thread conversation history is persisted (JSON files).
REACT_CORE_STATE_DIR=./.react-core

# Agent behaviour
REACT_CORE_MAX_STEPS=50
REACT_CORE_TEMPERATURE=0.2

# --- Debug recorder ---
# Set 0 to disable per-conversation JSON debug files.
# Files land at <REACT_CORE_STATE_DIR>/debug/threads/<thread_id>.json
REACT_CORE_DEBUG_RECORDING=1
REACT_CORE_DEBUG_MAX_EVENT_KB=256

# --- Prompt profile ---
# qa (default) | coding
PROMPT_PROFILE=qa
# When set, force the agent to pause at every checkpoint (Design/Cases/Automation/Delivery).
PROMPT_STRICT_CHECKPOINTS=0

# --- App DB (Phase 0+) ---
# sqlite (default) | postgres (future)
APP_DB_PROVIDER=sqlite

# --- Vector store (Phase 3) ---
# faiss (default) | pgvector (future)
VECTOR_STORE_PROVIDER=faiss
VECTOR_CHUNK_CHARS=1000
VECTOR_CHUNK_OVERLAP=100
VECTOR_TOP_K=5

# --- Attachments (Phase 1) ---
ATTACHMENT_MAX_FILE_MB=20
ATTACHMENT_MAX_TURN_MB=50