# DevAccel daemon — local configuration (gitignored).
# Created from .env.local.example.
#
# Every origin the daemon accepts is listed here, so this file is the single
# source of truth. Comma-separated, scheme + host + port, no trailing slash,
# no spaces needed (they are trimmed).

DEVACCEL_ALLOWED_ORIGINS="http://localhost:3000,http://localhost:3001,http://localhost:3002,http://127.0.0.1:3000,http://127.0.0.1:3001,http://127.0.0.1:3002,http://172.191.70.202:3002"

# Loopback origins are listed explicitly above, so the built-in dev defaults are
# switched off — the allowlist is exactly what this file says.
DEVACCEL_ALLOW_LOOPBACK_ORIGINS=false

# ── Optional ─────────────────────────────────────────────────────
# DEVACCEL_PORT=17872
# DEVACCEL_REQUIRE_AUTH=true
# DEVACCEL_UPDATE_HOSTS=".example.com"
