# =============================================================================
# DevSphere AI backend — environment template. Copy to `.env` and fill in.
# NEVER commit a real .env. Rotate any secret that has ever been committed.
# =============================================================================

# ── PostgreSQL ───────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=devsphere_ai
DB_USER=postgres
DB_PASSWORD=postgres
# Set to `require` when the DB is remote (auto-required for non-localhost hosts).
DB_SSL_MODE=

# ── Auth / JWT ───────────────────────────────────────────────────────────────
# REQUIRED. Long random string; the same secret verifies every token.
SECRET_KEY=
JWT_ALGORITHM=HS256
# jwt (default when SECRET_KEY set) | api_key | disabled (local single-user dev)
DEVSPHERE_AUTH_MODE=jwt

# ── LLM provider (Azure OpenAI) ──────────────────────────────────────────────
LLM_PROVIDER=azure
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-12-01-preview
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=
MODEL_CONTEXT_WINDOW=128000
LLM_MAX_OUTPUT_TOKENS=16000

# ── Azure Blob Storage (daemon binary distribution via SAS) ─────────────────
BLOB_STORAGE_ACCOUNT_NAME=
BLOB_STORAGE_ACCOUNT_KEY=
BLOB_STORAGE_CONTAINER_NAME=

# ── Agent behaviour ──────────────────────────────────────────────────────────
# Two modes:
#   manual (DEFAULT) — reads and searches run freely; every change (write,
#                      edit, terminal, git, MCP) pauses for human approval,
#                      and calls that touch credentials, database schema,
#                      deployment config or dependencies say so on the card.
#   auto             — nothing is gated.
# This is the server default when a request omits permission_mode (a CLI or
# API caller). The web UI sends its own per-request mode on top.
# LEAVE THIS UNSET to get `manual`. Setting it to `auto` turns off every
# approval prompt for callers that do not send their own mode — which is what
# an unattended pipeline wants and what an interactive user does not.
# Retired values (ask / standard / strict) are still accepted and normalised
# to `manual`; anything unrecognised also resolves to `manual`, never `auto`.
PERMISSION_MODE=manual

# How many tools from ONE model turn may execute at the same time. Parallel
# tool calls are what keep the agent fast when the workspace lives on the
# client's machine (N round trips collapse into one), so keep this above 1;
# the cap only stops a large batch from saturating the client or the TPM
# quota. Calls over the limit queue, they are never dropped. 0 = unlimited.
MAX_PARALLEL_TOOLS=8

# Set to false ONLY for a model that rejects the `parallel_tool_calls`
# request parameter. Normally leave unset — the LLM layer detects a rejection
# from the 400 and drops the parameter by itself.
# LLM_PARALLEL_TOOL_CALLS=true

# ── Attachment ingestion (ingestion/) ────────────────────────────────────────
# All optional — the defaults shown are what applies when unset. They bound
# what ONE upload can cost: a file too large to hold, or an extraction large
# enough to push the user's actual question out of the context window. Every
# rejection and truncation is reported to the user and to the model, so raising
# these is safe; lowering them is what a shared deployment does under load.
# INGEST_MAX_FILE_BYTES=26214400        # 25 MB — one upload
# INGEST_MAX_REQUEST_BYTES=104857600    # 100 MB — all uploads in one request
# INGEST_MAX_EXTRACTED_CHARS=200000     # text one file contributes (~50k tokens)
# INGEST_MAX_DIGEST_CHARS=12000         # per-file preview in the first message
# INGEST_MAX_IMAGES=8                   # images in one model turn
# INGEST_MAX_IMAGE_BYTES=5242880        # 5 MB — larger images are downscaled
# INGEST_MAX_PDF_PAGES=50               # pages whose text is read
# INGEST_MAX_PDF_RENDER_PAGES=5         # scanned pages rasterised for vision
# INGEST_MAX_SHEETS=20
# INGEST_MAX_SHEET_ROWS=500
# INGEST_MAX_SHEET_COLS=50
# INGEST_MAX_SLIDES=200
# INGEST_MAX_ARCHIVE_ENTRIES=200
# INGEST_MAX_NOTEBOOK_CELLS=300

# Force vision on/off for a deployment whose NAME doesn't reveal the model.
# Unset is correct almost always: capability is inferred from the name, and an
# unrecognised name is assumed vision-capable (every GPT-4o/4.1/5-class
# deployment is). Set false only if a deployment 400s on image parts.
# LLM_SUPPORTS_VISION=true

# ── Networking (cross-machine clients) ───────────────────────────────────────
DEVSPHERE_PORT=8003
DEVSPHERE_BIND_HOST=0.0.0.0
DEVSPHERE_PUBLIC_HOST=localhost

# ── Optional: multi-worker signal bus ────────────────────────────────────────
# REDIS_URL=redis://localhost:6379/0
