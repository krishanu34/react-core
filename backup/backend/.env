# =============================================================================
# DevSphere AI backend — host configuration.
# =============================================================================
# WHAT BELONGS HERE NOW
#   Only what the process needs BEFORE it can reach the database, plus per-host
#   infrastructure. Everything about MODELS — deployment, endpoint, api-version,
#   API key, context window, output ceiling, capabilities and pricing — lives in
#   the `model_configs` table and is managed at /admin/models. Adding or
#   changing a model needs no edit here and no restart.
#
#   See db/migrations/005_model_governance.sql and 006_model_api_key.sql.
#
# NEVER COMMIT THIS FILE. Rotate any secret that has ever been committed.
# =============================================================================

# ── PostgreSQL — bootstrap, so it cannot live in the database ────────────────
DB_HOST=sprintloop.postgres.database.azure.com
DB_PORT=5432
DB_NAME=devsphere
DB_USER=devacceluser
DB_PASSWORD=1q2w1q2w

# Optional separate vector store; falls back to the main DB when unset.
VECTOR_STORE_POSTGRES_DB_CONNECTION_STRING=postgresql://devacceluser:1q2w1q2w@sprintloop.postgres.database.azure.com:5432/devaccelv2

# ── Auth — bootstrap, verifies every JWT ─────────────────────────────────────
SECRET_KEY=M4wII20n9iReq_IiSaBFEUd25LlrLzTf0DRBH1Vlqp0M8P5t89cj1688poe2BWOB

# ── LLM provider ─────────────────────────────────────────────────────────────
# Selects which client implementation is used. The credentials and deployment
# for each model come from `model_configs`, not from here.
LLM_PROVIDER=azure

# OPTIONAL per-host fallback. Leave unset to run purely from the database.
# When set, these are used only for work with no per-user model (conversation
# summarisation, /chat/stream) and when the catalogue has no usable default.
# Anything set here is a SECOND place to keep in sync, so prefer /admin/models.
#   AZURE_OPENAI_ENDPOINT=
#   AZURE_OPENAI_API_KEY=
#   AZURE_OPENAI_API_VERSION=
#   AZURE_OPENAI_DEPLOYMENT=
#   MODEL_CONTEXT_WINDOW=
#   LLM_MAX_OUTPUT_TOKENS=
#   LLM_MODEL_ALIASES=fast=<deployment>:<window>,deep=<deployment>

# ── Agent behaviour ──────────────────────────────────────────────────────────
# Two modes:
#   manual (DEFAULT) — reads and searches run freely; every change (write,
#                      edit, terminal, git, MCP) pauses for human approval,
#                      and calls that touch credentials, database schema,
#                      deployment config or dependencies say so on the card.
#   auto             — nothing is gated.
# This is the server default when a request omits permission_mode (a CLI or
# API caller). The web UI sends its own per-request mode on top.
# LEAVE THIS UNSET to get `manual`. Setting it to `auto` turns off every
# approval prompt for callers that do not send their own mode — which is what
# an unattended pipeline wants and what an interactive user does not.
# Retired values (ask / standard / strict) are still accepted and normalised
# to `manual`; anything unrecognised also resolves to `manual`, never `auto`.
PERMISSION_MODE=manual

# Per-run token ceiling when no token_quotas row applies to the caller.
# 0 = unlimited. Per-user limits are set at /admin/quotas.
# MAX_AGENT_TOKENS=0

# ── Attachment ingestion (ingestion/) ────────────────────────────────────────
# Per-host, so it belongs here rather than in model_configs: these bound what a
# single upload can cost THIS machine (bytes held while parsing) and what it can
# cost the model (context window spent before the user's actual question).
#
# The values below ARE the code defaults — set explicitly so they are visible
# and tunable on this host. Deleting a line restores the default rather than
# disabling the limit. Every rejection and truncation is reported to the user
# and stated in the model's context, so raising these is safe; lowering them is
# what a shared deployment does under load.

# Transport — checked before any parser sees the bytes.
INGEST_MAX_FILE_BYTES=26214400        # 25 MB — one upload
INGEST_MAX_REQUEST_BYTES=104857600    # 100 MB — all uploads in one request

# Model-facing — how much of an extraction reaches the LLM.
INGEST_MAX_EXTRACTED_CHARS=200000     # text one file contributes (~50k tokens)
INGEST_MAX_DIGEST_CHARS=12000         # per-file preview in the first message
INGEST_MAX_IMAGES=8                   # images in one model turn
INGEST_MAX_IMAGE_BYTES=5242880        # 5 MB — larger images are downscaled

# Per-format structural caps.
INGEST_MAX_PDF_PAGES=50               # pages whose text is read
INGEST_MAX_PDF_RENDER_PAGES=5         # scanned pages rasterised for vision
INGEST_MAX_SHEETS=20
INGEST_MAX_SHEET_ROWS=500
INGEST_MAX_SHEET_COLS=50
INGEST_MAX_SLIDES=200
INGEST_MAX_ARCHIVE_ENTRIES=200
INGEST_MAX_NOTEBOOK_CELLS=300

# Force vision on/off for a deployment whose NAME doesn't reveal the model.
# LEFT UNSET DELIBERATELY: capability is inferred per-run from the model
# actually serving the request, and an unrecognised deployment name is assumed
# vision-capable (every GPT-4o/4.1/5-class one is). Setting this pins ALL models
# on this host to the same answer — including ones added later at /admin/models.
# Set false only if a deployment 400s on image parts.
# LLM_SUPPORTS_VISION=true

