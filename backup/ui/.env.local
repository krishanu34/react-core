# DevSphere AI UI — runtime configuration.
# Base URL of the DevSphere backend (auth + agent + workspace APIs).
NEXT_PUBLIC_DEVSPHERE_API_URL=http://localhost:8003
# Server-side proxy target (used by the /devsphere-api and /workspace-api route handlers).
# WORKSPACE_STUDIO_API_URL=http://devsphere-ai.devsphere.svc.cluster.local:8003
WORKSPACE_STUDIO_API_URL=http://127.0.0.1:8003